<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.14</version>
    <relativePath/>
  </parent>

  <groupId>com.inneragent.demo</groupId>
  <artifactId>demo-spring-host</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>demo-spring-host</name>
  <description>P1 出口验收演示宿主(开发计划 §2.6;[M1] 18c 扩充):空白 Spring Boot
    3.5.14/Java 21 应用,仅依赖 inneragent-spring-boot-starter + web,暴露
    get_host_time(READ)/create_host_record(WRITE,U1)与 get_product_brief(READ)/
    update_product_brief(WRITE,U2)/copy_flow_template(WRITE,U3)/
    list_login_records(READ,U5)六个 @IaTool 工具,端口 18091。</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- 接入面 = 1 条 starter 依赖(内含 MCP 桥 + act 验签 Filter)+ web -->
    <dependency>
      <groupId>com.inneragent</groupId>
      <artifactId>inneragent-spring-boot-starter</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- @IaTool 方法参数名经反射读取;未显式标注 @IaToolParam 时必需 -->
          <parameters>true</parameters>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
