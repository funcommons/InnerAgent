<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>funcommons.inneragent</groupId>
  <artifactId>mcp-bridge-spike</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>mcp-bridge-spike</name>
  <description>MCP bridge spike: validate Q1 verdict (official MCP Java SDK) for InnerAgent host tool bridge (/ia-mcp). Fully standalone - not part of any reactor.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Checklist item 1: latest stable official MCP Java SDK (verified 2026-09-20 via Maven Central metadata) -->
    <mcp-sdk.version>2.0.1</mcp-sdk.version>
    <!-- Aligned with ADR-T7: Spring Boot 3.5.x / Java 21 -->
    <spring-boot.version>3.5.16</spring-boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Official MCP Java SDK, convenience bundle = mcp-core + mcp-json-jackson3.
         Contains: client (HttpClientStreamableHttpTransport) + server servlet transport
         (HttpServletStreamableServerTransportProvider). Spring transports are NOT used:
         those moved to Spring AI 2.0 and are explicitly excluded by the tech spec (Q1 note). -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
      <version>${mcp-sdk.version}</version>
    </dependency>

    <!-- Real HTTP endpoint for the /ia-mcp style bridge (embedded Tomcat = Jakarta Servlet container) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
