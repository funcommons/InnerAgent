    "@types/uuid": "^10.0.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.11.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
